<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Catppuccin Mocha Colors -->
    <Color x:Key="Bg">#FF1e1e2e</Color>
    <Color x:Key="Titlebar">#FF181825</Color>
    <Color x:Key="Accent">#FF89b4fa</Color>
    <Color x:Key="Text">#FFcdd6f4</Color>
    <Color x:Key="TextDim">#FF6c7086</Color>
    <Color x:Key="Green">#FFa6e3a1</Color>
    <Color x:Key="GreenHover">#FFb8f0b0</Color>
    <Color x:Key="Red">#FFf38ba8</Color>
    <Color x:Key="RedHover">#FFf5a0b8</Color>
    <Color x:Key="RedDark">#FF8b3a4a</Color>
    <Color x:Key="Orange">#FFfab387</Color>
    <Color x:Key="Blue">#FF89b4fa</Color>
    <Color x:Key="Border">#FF313244</Color>
    <Color x:Key="Surface">#FF24243a</Color>
    <Color x:Key="CloseHover">#FFf38ba8</Color>
    <Color x:Key="PinActive">#FFf9e2af</Color>
    <Color x:Key="PinInactive">#FF6c7086</Color>
    <Color x:Key="TooltipBg">#FF313244</Color>
    <Color x:Key="MeterBg">#FF11111b</Color>
    <Color x:Key="MeterGreen">#FFa6e3a1</Color>
    <Color x:Key="MeterOrange">#FFfab387</Color>
    <Color x:Key="MeterRed">#FFf38ba8</Color>
    <Color x:Key="ProgressBg">#FF11111b</Color>
    <Color x:Key="ProgressFg">#FF89b4fa</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource Bg}" />
    <SolidColorBrush x:Key="TitlebarBrush" Color="{StaticResource Titlebar}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDim}" />
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource Green}" />
    <SolidColorBrush x:Key="GreenHoverBrush" Color="{StaticResource GreenHover}" />
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource Red}" />
    <SolidColorBrush x:Key="RedHoverBrush" Color="{StaticResource RedHover}" />
    <SolidColorBrush x:Key="RedDarkBrush" Color="{StaticResource RedDark}" />
    <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource Orange}" />
    <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource Blue}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="{StaticResource CloseHover}" />
    <SolidColorBrush x:Key="PinActiveBrush" Color="{StaticResource PinActive}" />
    <SolidColorBrush x:Key="PinInactiveBrush" Color="{StaticResource PinInactive}" />
    <SolidColorBrush x:Key="TooltipBgBrush" Color="{StaticResource TooltipBg}" />
    <SolidColorBrush x:Key="MeterBgBrush" Color="{StaticResource MeterBg}" />
    <SolidColorBrush x:Key="MeterGreenBrush" Color="{StaticResource MeterGreen}" />
    <SolidColorBrush x:Key="MeterOrangeBrush" Color="{StaticResource MeterOrange}" />
    <SolidColorBrush x:Key="MeterRedBrush" Color="{StaticResource MeterRed}" />
    <SolidColorBrush x:Key="ProgressBgBrush" Color="{StaticResource ProgressBg}" />
    <SolidColorBrush x:Key="ProgressFgBrush" Color="{StaticResource ProgressFg}" />

    <!-- TitleBarButtonStyle: flat button with hand cursor, TextDim foreground -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="32" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource SurfaceBrush}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CloseButtonStyle: hover bg is CloseHover with dark foreground -->
    <Style x:Key="CloseButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="32" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource CloseHoverBrush}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource BgBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PinButtonStyle: foreground toggles between PinActive/PinInactive via binding -->
    <Style x:Key="PinButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PinInactiveBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="32" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource SurfaceBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RecordButtonStyle: Green bg normally, Red when recording (DataTrigger on ShowStopIcon) -->
    <!-- Tag carries the hover brush so a single ControlTemplate handles both states -->
    <Style x:Key="RecordButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GreenBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Tag" Value="{StaticResource GreenHoverBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ShowStopIcon}" Value="True">
                <Setter Property="Background" Value="{StaticResource RedBrush}" />
                <Setter Property="Tag" Value="{StaticResource RedHoverBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- DarkContextMenuStyle -->
    <Style x:Key="DarkContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource TooltipBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- DarkMenuItemStyle -->
    <Style x:Key="DarkMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Background" Value="{StaticResource TooltipBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="6,4" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- DarkToolTipStyle -->
    <Style x:Key="DarkToolTipStyle" TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource TooltipBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

</ResourceDictionary>
